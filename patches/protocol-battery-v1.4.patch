+"""Synthetic checksum-adjusted battery frames are test data, not measured evidence."""
+import sys, unittest
+from pathlib import Path
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]/'src'))
+from frame import parse_frame
+
+def synthetic(raw):
+    b=bytearray.fromhex('681d00847f2efb290514bacfff000018fc0500f3ff0500840a6410e20443')
+    b[25]=raw; b[29]=sum(b[1:29])&255
+    return b
+
+class BatteryTests(unittest.TestCase):
+    def test_synthetic_boundaries(self):
+        for raw in (0,1,50,99,100,101,127,128,255):
+            with self.subTest(raw=raw):
+                f=parse_frame(synthetic(raw))
+                self.assertTrue(f['valid']); self.assertEqual(f['battery_raw'],raw)
+                self.assertEqual(f['battery_field_valid'],raw<=100)
+                self.assertEqual(f['battery_percent'],raw if raw<=100 else None)
+                self.assertEqual(f['battery_invalid_reason'],'' if raw<=100 else 'outside_candidate_range_0_100')
+                self.assertEqual(f['angle1_raw'],-1234)
+                self.assertEqual(f['unknown_23_26_hex'],synthetic(raw)[23:27].hex())
+    def test_checksum_and_format_gate(self):
+        b=synthetic(100);b[25]=50
+        f=parse_frame(b)
+        self.assertFalse(f['valid']);self.assertFalse(f['checksum_ok'])
+        self.assertEqual(f['battery_raw'],50);self.assertIsNone(f['battery_percent'])
+        self.assertFalse(f['battery_field_valid']);self.assertEqual(f['battery_invalid_reason'],'frame_invalid')
+        b=synthetic(100);b[0]=0;f=parse_frame(b)
+        self.assertFalse(f['battery_field_valid']);self.assertIsNone(f['battery_percent'])
+    def test_invalid_lengths(self):
+        for n in (0,1,25,26,29,31):
+            f=parse_frame(bytes(n))
+            self.assertFalse(f['valid']);self.assertIsNone(f['battery_raw'])
+            self.assertIsNone(f['battery_percent']);self.assertFalse(f['battery_field_valid'])
+
+if __name__=='__main__':unittest.main()
